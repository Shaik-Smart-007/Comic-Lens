# ComicLens Environment Configuration
# Copy this file to .env and fill in your Gemini API key:
#   copy .env.example .env (Windows PowerShell: Copy-Item .env.example .env)

# Required: Google Gemini API Key for accessing Gemma 4 models
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here

# Configurable Gemma 4 model identifier.
# Documented options:
#   - gemma-4-26b-a4b-it (Recommended default for multimodal analysis)
#   - gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
